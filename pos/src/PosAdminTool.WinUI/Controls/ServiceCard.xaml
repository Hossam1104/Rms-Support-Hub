<UserControl
    x:Class="PosAdminTool.WinUI.Controls.ServiceCard"
    x:Name="Root"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:PosAdminTool.WinUI.Controls">

    <Border Style="{StaticResource PanelBorderStyle}">
        <Grid RowSpacing="16">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <Grid ColumnSpacing="14">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <Border
                    Width="48"
                    Height="48"
                    Background="{ThemeResource SubtleFillBrush}"
                    BorderBrush="{Binding Status, ElementName=Root, Converter={StaticResource ServiceStatusToBrushConverter}}"
                    BorderThickness="1"
                    CornerRadius="12">
                    <TextBlock
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        FontSize="11"
                        FontWeight="Bold"
                        Foreground="{Binding Status, ElementName=Root, Converter={StaticResource ServiceStatusToBrushConverter}}"
                        Text="SVC" />
                </Border>

                <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="2">
                    <TextBlock
                        FontSize="16"
                        FontWeight="Bold"
                        Text="{Binding ServiceName, ElementName=Root}"
                        TextTrimming="CharacterEllipsis" />
                    <TextBlock Style="{StaticResource SecondaryTextStyle}" Text="Windows service endpoint" />
                </StackPanel>

                <Border Grid.Column="2" Style="{StaticResource StatusPillStyle}" VerticalAlignment="Center">
                    <StackPanel Orientation="Horizontal" Spacing="7">
                        <controls:StatusDot DotBrush="{Binding Status, ElementName=Root, Converter={StaticResource ServiceStatusToBrushConverter}}" />
                        <TextBlock
                            FontSize="12"
                            FontWeight="Bold"
                            Foreground="{Binding Status, ElementName=Root, Converter={StaticResource ServiceStatusToBrushConverter}}"
                            Text="{Binding Status, ElementName=Root}" />
                    </StackPanel>
                </Border>
            </Grid>

            <Border
                Grid.Row="1"
                Height="6"
                Background="{ThemeResource SubtleFillBrush}"
                CornerRadius="3">
                <Border
                    HorizontalAlignment="Stretch"
                    Background="{Binding Status, ElementName=Root, Converter={StaticResource ServiceStatusToBrushConverter}}"
                    CornerRadius="3" />
            </Border>

            <Grid Grid.Row="2" ColumnSpacing="8">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Button
                    HorizontalAlignment="Stretch"
                    Command="{Binding StartCommand, ElementName=Root}"
                    Content="Start"
                    Style="{StaticResource TealButtonStyle}" />
                <Button
                    Grid.Column="1"
                    HorizontalAlignment="Stretch"
                    Command="{Binding StopCommand, ElementName=Root}"
                    Content="Stop"
                    Style="{StaticResource GhostButtonStyle}" />
                <Button
                    Grid.Column="2"
                    HorizontalAlignment="Stretch"
                    Command="{Binding RestartCommand, ElementName=Root}"
                    Content="Restart"
                    Style="{StaticResource PrimaryButtonStyle}" />
            </Grid>
        </Grid>
    </Border>
</UserControl>

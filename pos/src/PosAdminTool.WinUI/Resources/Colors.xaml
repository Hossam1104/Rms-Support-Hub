<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <ResourceDictionary.ThemeDictionaries>

        <ResourceDictionary x:Key="Light">
            <Color x:Key="PageBackgroundColor">#F4F7FB</Color>
            <Color x:Key="ShellChromeColor">#EFF3F8</Color>
            <Color x:Key="CardColor">#FFFFFF</Color>
            <Color x:Key="CardStrongColor">#FFFFFF</Color>
            <Color x:Key="CardStrokeColor">#D9E2EC</Color>
            <Color x:Key="SubtleFillColor">#EEF4FA</Color>
            <Color x:Key="InputBackgroundColor">#F6F8FB</Color>
            <Color x:Key="HeroStartColor">#FFFFFF</Color>
            <Color x:Key="HeroEndColor">#EFF6FF</Color>
            <Color x:Key="HeroStrokeColor">#DCE7F6</Color>
            <Color x:Key="TextPrimaryColor">#111827</Color>
            <Color x:Key="TextSecondaryColor">#465466</Color>
            <Color x:Key="TextMutedColor">#7B8797</Color>
            <Color x:Key="ConsoleBackgroundColor">#F7FBFF</Color>
            <Color x:Key="ConsoleHeaderColor">#ECF3FA</Color>
            <Color x:Key="ConsoleTextColor">#175C41</Color>
            <Color x:Key="ConsoleBorderColor">#D4E2EF</Color>
            <Color x:Key="ConsoleMetaColor">#6E8194</Color>

            <SolidColorBrush x:Key="PageBackgroundBrush" Color="{StaticResource PageBackgroundColor}" />
            <SolidColorBrush x:Key="ShellChromeBrush" Color="{StaticResource ShellChromeColor}" />
            <SolidColorBrush x:Key="CardBackgroundBrush" Color="{StaticResource CardColor}" />
            <SolidColorBrush x:Key="CardBackgroundStrongBrush" Color="{StaticResource CardStrongColor}" />
            <SolidColorBrush x:Key="CardStrokeBrush" Color="{StaticResource CardStrokeColor}" />
            <SolidColorBrush x:Key="SubtleFillBrush" Color="{StaticResource SubtleFillColor}" />
            <SolidColorBrush x:Key="InputBackgroundBrush" Color="{StaticResource InputBackgroundColor}" />
            <SolidColorBrush x:Key="HeroStrokeBrush" Color="{StaticResource HeroStrokeColor}" />
            <SolidColorBrush x:Key="TextPrimaryBrush" Color="{StaticResource TextPrimaryColor}" />
            <SolidColorBrush x:Key="TextSecondaryBrush" Color="{StaticResource TextSecondaryColor}" />
            <SolidColorBrush x:Key="TextMutedBrush" Color="{StaticResource TextMutedColor}" />
            <LinearGradientBrush x:Key="HeroBackgroundBrush" StartPoint="0,0" EndPoint="1,1">
                <GradientStop Offset="0" Color="{StaticResource HeroStartColor}" />
                <GradientStop Offset="1" Color="{StaticResource HeroEndColor}" />
            </LinearGradientBrush>
            <SolidColorBrush x:Key="ConsoleBackgroundBrush" Color="{StaticResource ConsoleBackgroundColor}" />
            <SolidColorBrush x:Key="ConsoleHeaderBrush" Color="{StaticResource ConsoleHeaderColor}" />
            <SolidColorBrush x:Key="ConsoleTextBrush" Color="{StaticResource ConsoleTextColor}" />
            <SolidColorBrush x:Key="ConsoleBorderBrush" Color="{StaticResource ConsoleBorderColor}" />
            <SolidColorBrush x:Key="ConsoleMetaBrush" Color="{StaticResource ConsoleMetaColor}" />
        </ResourceDictionary>

        <ResourceDictionary x:Key="Dark">
            <Color x:Key="PageBackgroundColor">#0F1116</Color>
            <Color x:Key="ShellChromeColor">#131821</Color>
            <Color x:Key="CardColor">#1A202B</Color>
            <Color x:Key="CardStrongColor">#202733</Color>
            <Color x:Key="CardStrokeColor">#4B5C70</Color>
            <Color x:Key="SubtleFillColor">#202A38</Color>
            <Color x:Key="InputBackgroundColor">#202734</Color>
            <Color x:Key="HeroStartColor">#253246</Color>
            <Color x:Key="HeroEndColor">#131A24</Color>
            <Color x:Key="HeroStrokeColor">#557B8DA6</Color>
            <Color x:Key="TextPrimaryColor">#F5F7FA</Color>
            <Color x:Key="TextSecondaryColor">#D0D7E2</Color>
            <Color x:Key="TextMutedColor">#8D99AA</Color>
            <Color x:Key="ConsoleBackgroundColor">#0B1016</Color>
            <Color x:Key="ConsoleHeaderColor">#111822</Color>
            <Color x:Key="ConsoleTextColor">#B7F0C6</Color>
            <Color x:Key="ConsoleBorderColor">#3341A369</Color>
            <Color x:Key="ConsoleMetaColor">#88B7F0C6</Color>

            <SolidColorBrush x:Key="PageBackgroundBrush" Color="{StaticResource PageBackgroundColor}" />
            <SolidColorBrush x:Key="ShellChromeBrush" Color="{StaticResource ShellChromeColor}" />
            <SolidColorBrush x:Key="CardBackgroundBrush" Color="{StaticResource CardColor}" />
            <SolidColorBrush x:Key="CardBackgroundStrongBrush" Color="{StaticResource CardStrongColor}" />
            <SolidColorBrush x:Key="CardStrokeBrush" Color="{StaticResource CardStrokeColor}" />
            <SolidColorBrush x:Key="SubtleFillBrush" Color="{StaticResource SubtleFillColor}" />
            <SolidColorBrush x:Key="InputBackgroundBrush" Color="{StaticResource InputBackgroundColor}" />
            <SolidColorBrush x:Key="HeroStrokeBrush" Color="{StaticResource HeroStrokeColor}" />
            <SolidColorBrush x:Key="TextPrimaryBrush" Color="{StaticResource TextPrimaryColor}" />
            <SolidColorBrush x:Key="TextSecondaryBrush" Color="{StaticResource TextSecondaryColor}" />
            <SolidColorBrush x:Key="TextMutedBrush" Color="{StaticResource TextMutedColor}" />
            <LinearGradientBrush x:Key="HeroBackgroundBrush" StartPoint="0,0" EndPoint="1,1">
                <GradientStop Offset="0" Color="{StaticResource HeroStartColor}" />
                <GradientStop Offset="1" Color="{StaticResource HeroEndColor}" />
            </LinearGradientBrush>
            <SolidColorBrush x:Key="ConsoleBackgroundBrush" Color="{StaticResource ConsoleBackgroundColor}" />
            <SolidColorBrush x:Key="ConsoleHeaderBrush" Color="{StaticResource ConsoleHeaderColor}" />
            <SolidColorBrush x:Key="ConsoleTextBrush" Color="{StaticResource ConsoleTextColor}" />
            <SolidColorBrush x:Key="ConsoleBorderBrush" Color="{StaticResource ConsoleBorderColor}" />
            <SolidColorBrush x:Key="ConsoleMetaBrush" Color="{StaticResource ConsoleMetaColor}" />
        </ResourceDictionary>

    </ResourceDictionary.ThemeDictionaries>

    <!-- Theme-invariant brand and semantic accents (legible against both Light and Dark Mica) -->
    <Color x:Key="AccentBlueColor">#2899F5</Color>
    <Color x:Key="AccentTealColor">#14B8A6</Color>
    <Color x:Key="AccentGoldColor">#F2B84B</Color>
    <Color x:Key="DangerRedColor">#E74856</Color>
    <Color x:Key="SuccessColor">#0F9D58</Color>
    <Color x:Key="WarningColor">#C77800</Color>
    <Color x:Key="DangerColor">#D13438</Color>
    <Color x:Key="InfoColor">#0F6CBD</Color>

    <SolidColorBrush x:Key="AccentBlueBrush" Color="{StaticResource AccentBlueColor}" />
    <SolidColorBrush x:Key="AccentTealBrush" Color="{StaticResource AccentTealColor}" />
    <SolidColorBrush x:Key="AccentGoldBrush" Color="{StaticResource AccentGoldColor}" />
    <SolidColorBrush x:Key="DangerRedBrush" Color="{StaticResource DangerRedColor}" />
    <SolidColorBrush x:Key="SuccessBrush" Color="{StaticResource SuccessColor}" />
    <SolidColorBrush x:Key="WarningBrush" Color="{StaticResource WarningColor}" />
    <SolidColorBrush x:Key="DangerBrush" Color="{StaticResource DangerColor}" />
    <SolidColorBrush x:Key="InfoBrush" Color="{StaticResource InfoColor}" />
    <SolidColorBrush x:Key="DangerFillBrush" Color="#1AD13438" />

</ResourceDictionary>

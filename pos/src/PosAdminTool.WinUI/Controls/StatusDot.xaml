<UserControl
    x:Class="PosAdminTool.WinUI.Controls.StatusDot"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Grid x:Name="RootGrid" Width="12" Height="12">
        <Ellipse
            x:Name="OuterGlow"
            Fill="{x:Bind DotBrush, Mode=OneWay}"
            Opacity="0.25"
            RenderTransformOrigin="0.5,0.5">
            <Ellipse.RenderTransform>
                <ScaleTransform x:Name="OuterGlowScale" ScaleX="1" ScaleY="1" />
            </Ellipse.RenderTransform>
        </Ellipse>
        <Ellipse
            x:Name="InnerDot"
            Width="7"
            Height="7"
            HorizontalAlignment="Center"
            VerticalAlignment="Center"
            Fill="{x:Bind DotBrush, Mode=OneWay}" />
    </Grid>
</UserControl>

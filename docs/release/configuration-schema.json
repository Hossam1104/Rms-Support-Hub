{
  "schemaId": "rms-support-hub.configuration",
  "schemaVersion": 1,
  "section": "SupportHub",
  "deploymentTier": {
    "path": "SupportHub:DeploymentTier",
    "type": "string",
    "allowed": ["Testing", "Production"],
    "default": "Testing"
  },
  "healthProbe": {
    "path": "SupportHub:HealthProbe",
    "enabledDefault": true,
    "timeoutSecondsRange": [1, 30]
  },
  "environmentRegistration": {
    "path": "SupportHub:Environments:<ModuleKey>:<EnvironmentKey>",
    "endpointAuthority": "server-owned ModuleEndpoints and ModuleCancelEndpoints keys",
    "databaseAuthority": "server-owned ConnectionStrings name",
    "customEndpoints": "disabled"
  },
  "packagedTestingDefaults": {
    "runtimePath": "appsettings.json",
    "sourceTemplate": "deployment/appsettings.Testing.template.json",
    "deploymentTier": "Testing",
    "productionRegistrations": "disabled",
    "endpointValues": "placeholders or empty; inject authorized Testing values outside the package",
    "connectionStringValues": "placeholders or empty; inject authorized secrets outside the package",
    "productionDatabaseOverrides": "absent"
  },
  "runtimeStorage": {
    "path": "var/drafts",
    "requiredAccess": "IIS application-pool identity Modify"
  }
}
